{
  "name": "bpbd-public-site",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "npx @tailwindcss/cli -i ./src/css/input.css -o ./src/assets/css/style.css",
    "css:watch": "npx @tailwindcss/cli -i ./src/css/input.css -o ./src/assets/css/style.css --watch",
    "start": "concurrently -k \"npm run css:watch\" \"eleventy --serve\"",
    "build": "npm run css && eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@tailwindcss/cli": "^4.1.13",
    "@tailwindcss/typography": "^0.5.16",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.13"
  }
}
